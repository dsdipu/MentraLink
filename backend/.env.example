# Copy this file to .env and fill in real values. NEVER commit the real .env file.

NODE_ENV=development            # set to "production" when deployed (hides internal error details, enables HSTS)
PORT=5000
MONGO_URI=your_actual_mongodb_connection_string

# Use a long random value, at least 32 characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_actual_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of frontend origins that may call this API
FRONTEND_URLS=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# University e-mail domain used for student IDs (ID@domain) and for bulk account creation
ALLOWED_STUDENT_EMAIL_DOMAIN=@student.yourschool.edu

# First admin account created by the seed script. The password must satisfy the strong password policy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me-To-A-Strong-Passw0rd!

TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# E-mail sending (Brevo)
BREVO_API_KEY=your_brevo_api_key
EMAIL_USER=sender@example.com
